# Copy to .env.local and fill from the output of `npx supabase start`.
# .env.local is gitignored. Never put cloud project values in it.

# --- Local Supabase (from `npx supabase start`) ---
# Local values are shared defaults, identical on every machine. NOT secrets.
# Production values live only in Vercel.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Replaces the legacy anon key.
# Safe in the browser — RLS is what gates every query.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Replaces the legacy service_role key.
# Carries BYPASSRLS — skips every policy. SERVER ONLY.
# Never prefixed NEXT_PUBLIC_. Any file importing it needs `import 'server-only'`.
# Used by: the recurring-expense cron job, CSV import. Nothing else.
# Read in exactly one place, lib/supabase/admin.ts; `npm run check:secrets`
# fails the build if that ever stops being true.
SUPABASE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=VND
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# --- Cron ---
# Checked by GET/POST /api/cron/recurring before it will generate anything,
# sent as `Authorization: Bearer <secret>`. Any long random string. Unset means
# the endpoint refuses every request rather than defaulting to open.
# The scheduled run does not use this path at all: pg_cron calls
# generate_due_recurrences() inside Postgres (migration 0017).
CRON_SECRET=
