# Copy to .env.local and fill from the output of `npx supabase start`.
# .env.local is gitignored. Never put cloud project values in it.

# --- Local Supabase (from `npx supabase start`) ---
# These local values are fixed demo constants, identical on every machine.
# They are NOT secrets. Production values live only in Vercel.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row-level security. Server-only.
# Any file importing this must have `import 'server-only'` at the top.
# Used by: the recurring-expense cron job, CSV import. Nothing else.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=VND
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# --- Cron ---
# Random string; the recurring-expense endpoint rejects requests without it.
CRON_SECRET=
